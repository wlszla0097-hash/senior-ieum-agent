# 환경 변수 견본 — 복사해서 .env 로 만들고 값을 넣는다 (.env 는 깃에 올리지 않음). 배포는 Render/Vercel 대시보드에 입력.
# 비워 두면: OPENAI_API_KEY 없음 → 채팅만 안내 문구 / FIREBASE 없음 → 메모리 저장소
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# 교육장 게이트웨이(OpenAI 호환)를 쓰면: OPENAI_BASE_URL=https://copa.codyssey.kr/v1 , AI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
# 서비스 계정 JSON 내용을 한 줄로, 또는 JSON 파일 경로 (예: ./serviceAccount.json)
FIREBASE_SERVICE_ACCOUNT_JSON=
# CORS 허용 프론트 주소, 쉼표 구분. 배포 후 Vercel 주소 추가
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# 선택: 외부 Senior_ieum 규칙엔진 주소. 비우면 내장 규칙엔진(programs/senior/rules.py) 사용
SENIOR_API_URL=
